                ".form-control": {
                  "padding": "8px 0",
                  "border": "none !important",
                  "border-radius": "0",
                  "border-bottom": "1px solid @border !important",
                  "box-shadow": "none",
                  "background-color": "transparent",
                  "&::placeholder": {
                    "color": "@border"
                  },
                  "&:hover, &:focus": {
                    "border": "none !important",
                    "box-shadow": "none",
                    "border-bottom": "1px solid @border !important"
                  }
                },
                ".form-check": {
                  "padding-left": "2.4rem",
                  "margin-bottom": "8px",
                  ".form-check-input": {
                    "background-color": "@border",
                    "border-color": "@border"
                  }
                }
