              },
              "li": {
                "margin-bottom": "24px",
                "transition": "all .3s ease",
                "&:hover": {
                  "color": "@secondaryColor"
                }
              },
              "color": "#ffffff",
              "text-align": "center"
            },
            ".copyright": {
              "margin": "32px 0 0 0",
              "@media (max-width: 768px)": {
