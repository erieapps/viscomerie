              "@media (max-width: 768px)": {
                "text-align": "center"
              },
              "color": "#f7760c",
              "text-align": "left"
            },
            ".soc-wrapper": {
              "display": "flex",
              "flex-wrap": "wrap",
              "@media (max-width: 768px)": {
                "margin-bottom": "22px",
                "display": "block"
              },
              ".mbr-soc": {
                "margin-bottom": "16px",
                "margin-right": "30px",
                "transition": "all .3s ease",
                "&:hover": {
                  "opacity": ".7"
                },
                "@media (max-width: 950px)": {
                  "margin-right": "0",
