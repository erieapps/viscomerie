            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 30px"
              }
            },
            ".map-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "55px"
              },
              ".google-map": {
                "padding": "0 120px 0 60px",
                "& when (@reverseContent)": {
                  "padding": "0 60px 0 120px",
                  "@media (max-width: 1200px)": {
                    "padding": "0 30px"
                  },
                  "@media (max-width: 992px)": {
                    "padding": "0"
                  }
                },
                "@media (max-width: 1200px)": {
                  "padding": "0 30px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0"
                },
                "iframe": {
                  "height": "720px",
                  "@media (max-width: 992px)": {
                    "height": "300px"
                  }
                }
              }
            },
            ".form-wrap": {
              "display": "flex",
              "align-items": "center"
            },
            ".dragArea.row": {
              ".mbr-section-title": {
                "margin-bottom": "32px !important"
              },
              ".mbr-text": {
                "margin-bottom": "20px !important"
              },
              ".form-group": {
                "margin-bottom": "20px",
                ".form-control": {
                  "padding": "8px 0",
                  "border": "none !important",
                  "border-radius": "0",
                  "border-bottom": "1px solid @border !important",
                  "box-shadow": "none",
                  "background-color": "transparent",
                  "&::placeholder": {
                    "color": "@border"
                  },
                  "&:hover, &:focus": {
                    "border": "none !important",
                    "box-shadow": "none",
                    "border-bottom": "1px solid @border !important"
                  }
                },
                ".form-check": {
                  "padding-left": "2.4rem",
                  "margin-bottom": "8px",
                  ".form-check-input": {
                    "background-color": "@border",
                    "border-color": "@border"
                  }
                }
              },
              ".mbr-section-btn": {
                "margin-top": "40px"
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".mbr-text": {
              "color": "#ffffff",
              "text-align": "center"
            },
            "label": {
