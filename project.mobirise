        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "@media (min-width: 992px)": {
              ".row": {
                "justify-content": "center"
              },
              ".card": {
                "padding": "0 45px 0 100px"
              },
              ".card:nth-child(2n)": {
                "padding": "0 100px 0 45px"
              }
            },
            ".title-wrapper": {
              "margin": "0 0 120px 0",
              "@media (max-width: 992px)": {
                "margin": "0 0 60px 0"
              },
              ".mbr-section-title": {
                "margin-bottom": "0"
              }
            },
            ".card-wrapper": {
              "margin-bottom": "50px",
              "img": {
                "width": "100%",
                "height": "280px",
                "border-radius": "20px",
                "margin-bottom": "40px",
                "object-fit": "cover",
                "@media (max-width: 992px)": {
                  "height": "250px",
                  "margin-bottom": "24px"
                }
              },
              ".mbr-card-title": {
                "margin-bottom": "20px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "16px"
                }
              },
              ".mbr-desc": {
                "margin-bottom": "24px"
              }
            },
            ".mbr-section-title": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-card-title": {
              "color": "#570000"
            },
            ".mbr-desc": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-card-title, .mbr-section-btn": {
              "text-align": "center",
              "color": "#000000"
            }
          },
          "_name": "features4",
          "_sourceTheme": "resultm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features4 resultm5\" group=\"Features\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n        'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"2\" max=\"10\" step=\"1\" value=\"9\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"2\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <select title=\"Item Amount\" name=\"cards\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Desc\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Card Button\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/mbr-687x442.jpg\" parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#fc8f12\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 card\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\"><b>Shaping the Future of Building Communications</b></h2>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5 col-md-6 card\">\n                <div class=\"card-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/p1106984-670x893.jpg\" alt=\"Server Room Experience IT Infrastructure\">\n                    <h3 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\".mbr-card-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showCardTitle\">\n                        Our Solution:</h3>\n                    <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">\n                        Viscom Systems is your gateway to advanced building communications infrastructures. Our vision is to offer the best of both worlds: quality, local, face-to-face service backed by the research, development, and technological support of industry giants. We're proud partners with Ortronics, Vicon, Avaya, Identicard, and Cambridge Sound, bringing you the forefront of communication technology.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                        <a class=\"btn btn-danger-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            See more\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5 col-md-6 card\" mbr-if=\"cards > 1\">\n                <div class=\"card-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/p1107008-1245x934.jpg\" alt=\"IT Infrastructure Cabling\">\n                    <h3 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\".mbr-card-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showCardTitle\">\n                        Why Viscom?</h3>\n                    <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">Our pride is in our work, and we approach every project with dedication and professionalism. <br><br>With us, your project will be completed efficiently, courteously, and with utmost quality. Our clients enjoy some of the highest warranties in the business, guaranteeing your peace of mind knowing your project will be completed on time and within budget.<br><br></p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                        <a class=\"btn btn-danger-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            See more\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5 col-md-6 card\" mbr-if=\"cards > 2\">\n                <div class=\"card-wrapper\">\n                    <img src=\"../_images/result/image14.jpg\" alt=\"Mobirise\">\n                    <h3 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\".mbr-card-title, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                        At dolorem nam non voluptates quidem\n                    </h3>\n                    <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\">\n                        Lorem ipsum dolor sit amet, consectetur adipisicing elit. Architecto aspernatur autem cupiditate\n                        distinctio exercitationem fugiat fugit minima nam, nesciunt nobis. Itaque, laboriosam, sequi\n                        accusamus.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                        <a class=\"btn btn-danger-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            See more\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5 col-md-6 card\" mbr-if=\"cards > 3\">\n                <div class=\"card-wrapper\">\n                    <img src=\"../_images/result/image12.jpg\" alt=\"Mobirise\">\n                    <h3 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\".mbr-card-title, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                        Quidem quos ratione reiciendis repellendus\n                    </h3>\n                    <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\">\n                        Adipisicing elit. Aliquid consectetur delectus eum\n                        eveniet illum iure laudantium nemo nesciunt non obcaecati, quidem quos ratione reiciendis\n                        repellendus sapiente ut vel veritatis voluptatem.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                        <a class=\"btn btn-danger-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            See more\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tJalRgNXUE",
          "_anchor": "features4-1m",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
