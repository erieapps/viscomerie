    "IT_Infrastructure.html": {
      "settings": {
        "title": "Seamless, Scalable, and Secure IT Infrastructure Services",
        "order": "2",
        "meta_descr": "Discover robust IT infrastructure services designed for your business growth. We offer scalable, secure, and innovative solutions tailored to your needs, ensuring optimal performance and efficiency. Elevate your business to new heights with our industry-leading IT support and infrastructure management."
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "& when not (@transparent)": {
                "position": "relative",
                "min-height": "120px"
              },
              "nav.navbar": {
                "position": "fixed"
              }
            },
            ".container-fluid": {
              "padding": "0"
            },
