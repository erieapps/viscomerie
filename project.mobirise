    "index.html": {
      "settings": {
        "main": true,
        "title": "Viscom Systems - HOME",
        "meta_descr": "Vision Communications Inc., d/b/a - Viscom Systems was established in 1995 and has always been locally owned and operated. Our goal is to offer our customers the best in telecommunications, safety, security and surveillance services.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": ""
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "& when not (@transparent)": {
                "position": "relative",
                "min-height": "120px"
              },
              "nav.navbar": {
                "position": "fixed"
              }
            },
            ".container-fluid": {
              "padding": "0"
            },
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "4px",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
            },
            ".dropdown-item": {
              "border-bottom": "1px solid #e6e6e6",
              "&:hover, &:focus": {
                "background": "@primaryColor !important",
                "color": "white !important"
              },
              "&:first-child": {
                "border-top-left-radius": "4px",
                "border-top-right-radius": "4px"
              },
              "&:last-child": {
                "border-bottom": "none",
                "border-bottom-left-radius": "4px",
                "border-bottom-right-radius": "4px"
              }
            },
            ".nav-dropdown .link": {
              "padding": "0 0.3em !important",
              "margin": "0.667em 1em !important"
            },
            ".nav-dropdown .link.dropdown-toggle::after": {
              "margin-left": "0.5rem",
              "margin-top": "0.2rem"
            },
            ".nav-link": {
              "position": "relative",
              "&::before": {
                "background-color": "currentColor",
                "display": "block",
                "position": "absolute",
                "bottom": "0",
                "left": "0",
                "content": "\"\"",
                "height": "1px",
                "width": "0%",
                "-webkit-transition": "width 0.5s ease-in-out",
                "-moz--transition": "width 0.5s ease-in-out",
                "transition": "width 0.5s ease-in-out"
              },
              "&::after": {
                "background": "transparent !important"
              },
              "&:hover,:focus": {
                "&::before": {
                  "width": "100%"
                }
              }
            },
            ".container": {
              "display": "flex",
              "margin": "auto"
            },
            ".iconfont-wrapper": {
              "color": "@iconsColor !important",
              "font-size": "1.5rem",
              "padding-right": "0.5rem",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "margin-right": "0.5rem",
              "padding": "0.5rem",
              "height": "2.5rem",
              "width": "2.5rem",
              "border": "1px solid currentColor",
              "&:hover": {
                "background": "#FFFFFF",
                "& .mbr-iconfont": {
                  "color": "#141414"
                }
              }
            },
            ".dropdown-menu, .navbar.opened": {
