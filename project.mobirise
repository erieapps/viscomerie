              }
            },
            "@media (min-width: 992px)": {
              ".row": {
                "justify-content": "center"
              },
              ".card": {
                "padding": "0 45px 0 100px"
              },
              ".card:nth-child(2n)": {
                "padding": "0 100px 0 45px"
              }
