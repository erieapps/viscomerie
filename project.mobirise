            ".row": {
              "align-items": "center"
            },
            ".text-wrapper": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "flex-start"
            },
            ".header-text": {
              "width": "100%",
              "margin-bottom": "40px",
              "@media (max-width: 767px)": {
                "margin-bottom": "20px"
              }
            },
            ".mbr-section-title": {
              "width": "100%",
              "color": "#ffffff",
              "margin-bottom": "0"
            },
            ".mbr-text": {
              "color": "#ffffff",
              "width": "100%",
              "margin-bottom": "0",
