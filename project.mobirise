        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "@media (min-width: 992px)": {
              ".card": {
                "padding": "0 80px",
                "&:first-child": {
                  "display": "flex",
                  "flex-direction": "column",
                  "justify-content": "center"
                }
              }
            },
            ".title-wrapper": {
              "margin": "0 0 53px 0",
              "@media (max-width: 992px)": {
                "margin": "20px 0 0 0"
              },
              ".mbr-section-title": {
                "margin-bottom": "0"
              }
            },
            ".panel-group": {
              "@media (max-width: 992px)": {
                "margin-bottom": "32px"
              },
              ".card": {
                "padding": "16px 0 24px 0",
                "border-radius": "0",
                "&:not(:first-child)": {
                  "border-top": "1px solid @border"
                },
                ".card-header": {
                  "background-color": "transparent",
                  "padding": "13px 0",
                  "border": "none",
                  "@media (max-width: 768px)": {
                    "padding": "0 0 10px"
                  },
                  ".panel-title": {
                    "display": "flex",
                    "justify-content": "space-between",
                    "align-items": "center",
                    "&:not(.collapsed)": {
                      ".mbr-iconfont": {
                        "opacity": "0"
                      }
                    },
                    ".panel-title-edit": {
                      "margin": "0",
                      "width": "100%"
                    },
                    ".mbr-iconfont": {
                      "margin-left": "10px",
                      "transition": "all .3s ease"
                    }
                  }
                },
                ".panel-collapse": {
                  ".panel-body": {
                    ".panel-text": {
                      "margin": "0"
                    }
                  }
                }
              }
            },
            ".image-wrapper": {
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "position": "relative",
              "height": "500px",
              "@media (max-width: 425px)": {
                "height": "400px"
              },
              ".image-main": {
                "width": "100%",
                "object-fit": "cover",
                "border-radius": "20px"
              },
              ".mbr-emoji": {
                "position": "absolute",
                "top": "0",
                "right": "9rem",
                "font-size": "52px",
                "&:nth-child(2)": {
                  "left": "4rem",
                  "top": "22%"
                },
                "&:nth-child(3)": {
                  "font-size": "72px",
                  "right": "3.5rem",
                  "top": "40%"
                },
                "&:nth-child(4)": {
                  "font-size": "102px",
                  "top": "auto",
                  "left": "7rem",
                  "bottom": "1rem"
                },
                "&:nth-child(5)": {
                  "font-size": "46px",
                  "top": "auto",
                  "bottom": "0",
                  "left": "50%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#3e3e3e",
              "text-align": "left"
            },
            ".panel-title-edit, .mbr-iconfont": {
              "color": "#ffffff",
              "text-align": "left"
            },
            ".panel-text": {
              "color": "#f7760c"
            }
          },
          "_name": "content1",
          "_sourceTheme": "resultm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content1 resultm5\" group=\"List\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n        'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"7\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <select title=\"Item Amount\" name=\"cardAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Item Border\" value=\"#fc8f12\" name=\"border\" selected>\n        <input type=\"checkbox\" title=\"Images\" name=\"showImages\" checked>\n        <input type=\"range\" inline title=\"Emoji Amount\" name=\"icons\" min=\"0\" max=\"5\" step=\"1\" value=\"0\" condition=\"showImages\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value parallax>\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-6 card\">\n                <div class=\"right-image-slide-in\">\n                <div class=\"image-wrapper\" mbr-if=\"showImages\">\n                    <img class=\"image-main\" src=\"@PROJECT_PATH@/assets/images/mbr-833x555.jpg\" alt=\"Security Camera Outside\">\n                    <p class=\"mbr-emoji mbr-fonts-style\" mbr-if=\"icons > 0\">🔅</p>\n                    <p class=\"mbr-emoji mbr-fonts-style\" mbr-if=\"icons > 1\">💜</p>\n                    <p class=\"mbr-emoji mbr-fonts-style\" mbr-if=\"icons > 2\">📒</p>\n                    <p class=\"mbr-emoji mbr-fonts-style\" mbr-if=\"icons > 3\">😁</p>\n                    <p class=\"mbr-emoji mbr-fonts-style\" mbr-if=\"icons > 4\">🔆</p>\n                </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 card\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">Cameras &amp; Security Systems</h2>\n                </div>\n                <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                    <div class=\"card\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit, .mbr-iconfont\">Why&nbsp;<b>Viscom Systems</b> for your CCTV and Security Needs?</h4>\n                                <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                            </a>\n                        </div>\n                        <div id=\"collapse1\" class=\"panel-collapse noScroll collapse show\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">In today’s society security is essential. Give us a call and we can guide you as to how, where and what kind of security system and cameras would best suit your place of business.\n<br>\n<br>Video recording has been becoming more of a need than a convenience. With today's technologies, you can keep track of employees along with visitors without missing a beat.\n<br><br>Many of these systems can seamlessly integrate with Identicard access control allowing a visual record of who accessed your building along with the standard access control log.<br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 1\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit, .mbr-iconfont\">Our Solutions:</h4>\n                                <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                            </a>\n                        </div>\n                        <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">CCTV<br>DVR and NVR Systems<br>Network Cameras<br>Analog Cameras<br>IP Network Security Solutions<br>VMS (Video Management Software)</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 2\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit, .mbr-iconfont\">\n                                    Architecto asperiores aut?\n                                </h4>\n                                <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                            </a>\n                        </div>\n                        <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">\n                                    Lorem ipsum dolor sit amet, consectetur adipisicing elit. Animi cum deleniti dolorem\n                                    eaque, inventore ipsum iusto, odit quaerat rerum totam ullam voluptas! Distinctio id\n                                    ipsam itaque quidem quis quo ratione. Consectetur adipisicing elit. Accusantium\n                                    alias\n                                    architecto asperiores aut blanditiis distinctio dolor inventore magnam minus natus\n                                    nihil perferendis porro, quia, quisquam recusandae sed tenetur ullam veniam.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 3\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit, .mbr-iconfont\">\n                                    Recusandae sed tenetur ullam?\n                                </h4>\n                                <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                            </a>\n                        </div>\n                        <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">\n                                    Lorem ipsum dolor sit amet, consectetur adipisicing elit. Aperiam enim esse,\n                                    exercitationem impedit maiores maxime optio soluta. Culpa dignissimos, doloremque\n                                    exercitationem fugiat id possimus similique veniam. Earum labore magnam qui.\n                                    architecto asperiores aut blanditiis distinctio dolor inventore magnam minus natus\n                                    nihil perferendis porro, quia, quisquam recusandae sed tenetur ullam veniam.</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
