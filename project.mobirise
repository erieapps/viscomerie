                "transition": "all .3s ease",
                "&:hover": {
                  "color": "@secondaryColor"
                }
              },
              "color": "#ffffff",
              "text-align": "center"
            },
            ".copyright": {
              "margin": "32px 0 0 0",
              "@media (max-width: 768px)": {
                "text-align": "center"
              },
              "color": "#bbbbbb",
              "text-align": "center"
            },
            ".mbr-soc, .mbr-iconfont": {
              "color": "#e8e8e8",
              "text-align": "left"
            }
          },
          "_name": "footer1",
          "_sourceTheme": "supplym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer1\" global once=\"footers\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" name=\"socialCount\" title=\"Social Count\" min=\"1\" max=\"4\" step=\"1\" value=\"4\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Icons Bg\" value=\"#f7760c\" name=\"icon\" condition=\"showSocial\" selected>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopyright\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-6 col-md-6\">\n                <h3 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>\n                    VISCOM SYSTEMS</b><br></h3>\n                <div class=\"soc-wrapper\" mbr-if=\"showSocial\">\n                    <p class=\"mbr-soc mbr-fonts-style\" data-app-selector=\".mbr-soc, .mbr-iconfont\" mbr-theme-style=\"display-7\">\n                        <span class=\"mobi-mbri mobi-mbri-letter mbr-iconfont\"></span><a href=\"mailto:cluafer@viscomerie.com\" class=\"text-info\">&nbsp;jtebalt@viscomerie.com</a></p>\n                    <p class=\"mbr-soc mbr-fonts-style\" data-app-selector=\".mbr-soc, .mbr-iconfont\" mbr-theme-style=\"display-7\" mbr-if=\"socialCount > 1\">\n                        <span class=\"mobi-mbri mobi-mbri-mobile mbr-iconfont\"></span><a href=\"tel:+1-814-899-2460\" class=\"text-info\" style=\"font-size: 1.4rem;\">814.899.2460</a></p>\n                    <p class=\"mbr-soc mbr-fonts-style\" data-app-selector=\".mbr-soc, .mbr-iconfont\" mbr-theme-style=\"display-7\" mbr-if=\"socialCount > 2\">\n                        <span class=\"mobi-mbri mobi-mbri-map-pin mbr-iconfont\"></span><a href=\"https://goo.gl/maps/whBTXzejXt672H5y5\" class=\"text-info\" style=\"font-size: 1.4rem;\">4616 Buffalo Rd</a><span style=\"font-size: 1.4rem;\">.&nbsp;</span><a href=\"https://goo.gl/maps/whBTXzejXt672H5y5\" class=\"text-info\" style=\"font-size: 1.4rem;\">Erie, PA, 16510</a></p>\n                    <p class=\"mbr-soc mbr-fonts-style\" data-app-selector=\".mbr-soc, .mbr-iconfont\" mbr-theme-style=\"display-7\" mbr-if=\"socialCount > 3\">\n                        <span class=\"mobi-mbri mobi-mbri-add-submenu mbr-iconfont\"></span><a href=\"Industry_Experience.html\" class=\"text-warning\">INDUSTRY EXPERIENCE</a></p>                                                                    \n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 col-md-6\">\n                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list\" data-multiline mbr-article mbr-if=\"showList\">\n                    <li class=\"mbr-text item-wrap\"><span style=\"font-size: calc(1.28rem + 0.52 * ((100vw - 20rem) / 28));\">SIN</span><span style=\"font-size: calc(1.28rem + 0.52 * ((100vw - 20rem) / 28));\">CE&nbsp;</span><i style=\"color: rgb(252, 143, 18); font-size: calc(1.28rem + 0.52 * ((100vw - 20rem) / 28));\">1995!</i></li>\n                </ul>\n            </div>\n            <div class=\"col-12\" mbr-if=\"showCopyright\">\n                <p class=\"mbr-fonts-style copyright\" mbr-theme-style=\"display-4\" data-app-selector=\".copyright\">© Copyright 2025 Viscom Systems - All Rights Reserved<br>POWERED by <b><a href=\"https://erieapps.com\" class=\"text-danger\">ERIE APPLICATIONS</a></b></p>\n            </div>\n        </div>\n    </div>\n</section>",
