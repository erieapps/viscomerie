            },
            ".iconfont-wrapper": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "min-width": "22px",
              "aspect-ratio": "(1 / 1)",
              "padding": "4px",
              "border-radius": "50%",
              "background-color": "@iconBgColor",
              "margin-right": "10px",
