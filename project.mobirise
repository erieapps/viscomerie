          "_name": "form1",
          "_sourceTheme": "careerm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form1 careerm5\" group=\"Forms\" plugins=\"formstyler, datepicker\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Map</header>\n        <input type=\"checkbox\" title=\"Map\" name=\"showMap\" checked>\n        <input type=\"map\" title=\"Address\" name=\"googleMap\" condition=\"showMap\" place-id=\"4616 Buffalo Rd, Erie, PA 16510\" value=\"4616 Buffalo Rd, Erie, PA 16510\">\n        <header>Show/Hide</header>\n        <input type=\"color\" title=\"Border Color\" value=\"#ffffff\" name=\"border\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"map-wrapper\" mbr-if=\"showMap\">\n                    <div class=\"google-map\" mbr-map=\"googleMap\">\n                    </div>\n                </div>\n            </div>\n            <div mbr-form class=\"col-lg-6 mx-auto mbr-form form-wrap\">\n                <form action=\"info@erieapplications.com\" name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\" data-verified=\"info@erieapplications.com\">\n                    <div class=\"row\">\n                        <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thanks, we will get back to you as soon as we can!</div>\n                        <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"> Oops...! some\n                            problem!\n                        </div>\n                    </div>\n                    <div class=\"dragArea row\">\n                        <div class=\"col-lg-12 col-md-12 col-sm-12\">\n                            <h2 mbr-theme-style=\"display-1\" class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\">Choose<br><b>Viscom</b> <b>Systems</b> <br>for your sound masking and paging.</h2>\n                        </div>\n                        <div class=\"col-lg-12 col-md-12 col-sm-12\">\n                            <p mbr-theme-style=\"display-7\" mbr-if=\"showText\" class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\">Let us show you why Viscom Systems should be your first choice for communications, security, and safety solutions.<br></p>\n                        </div>\n                        <div data-for=\"email\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n                            <input type=\"email\" name=\"email\" placeholder=\"Email\" data-form-field=\"email\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n                        </div>\n                        <div data-for=\"text\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n                            <input type=\"text\" name=\"text\" placeholder=\"Name\" data-form-field=\"text\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n                        </div>\n                        <div data-for=\"message\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n                            <input type=\"text\" name=\"message\" placeholder=\"Message\" data-form-field=\"message\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n                        </div>\n                        <div class=\"col-md-auto col mbr-section-btn \" mbr-buttons=\"true\" mbr-theme-style=\"display-5\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\"><a type=\"submit\" class=\"btn btn-black\" data-app-placeholder=\"Type Text\">\n                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                Send</a></div>\n                    </div>\n                </form>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "form1-2z",
          "_isUserblock": true,
          "_cid": "tJx4DPZIHB",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-title": {
              "margin-bottom": "24px",
              "@media (max-width: 768px)": {
                "text-align": "center"
              },
              "color": "#f7760c",
              "text-align": "left"
            },
            ".soc-wrapper": {
              "display": "flex",
              "flex-wrap": "wrap",
              "@media (max-width: 768px)": {
                "margin-bottom": "22px",
                "display": "block"
              },
              ".mbr-soc": {
                "margin-bottom": "16px",
                "margin-right": "30px",
                "transition": "all .3s ease",
                "&:hover": {
                  "opacity": ".7"
                },
                "@media (max-width: 950px)": {
                  "margin-right": "0",
                  "text-align": "center"
                },
                ".mbr-iconfont": {
                  "margin-right": "15px",
                  "font-size": "20px",
                  "width": "31px",
                  "height": "31px",
                  "display": "inline-flex",
                  "justify-content": "center",
                  "align-items": "center",
                  "background-color": "@icon",
                  "border-radius": "100%"
                }
              }
            },
            ".list": {
              "list-style-type": "none",
              "padding": "1rem 0 0 0",
              "margin": "0",
              "@media (max-width: 950px)": {
                "text-align": "center"
              },
              "li": {
                "margin-bottom": "24px",
                "transition": "all .3s ease",
                "&:hover": {
                  "color": "@secondaryColor"
                }
              },
              "color": "#ffffff",
              "text-align": "center"
            },
            ".copyright": {
              "margin": "32px 0 0 0",
              "@media (max-width: 768px)": {
                "text-align": "center"
              },
              "color": "#bbbbbb",
              "text-align": "center"
            },
            ".mbr-soc, .mbr-iconfont": {
              "color": "#e8e8e8",
              "text-align": "left"
            }
          },
          "_name": "footer1",
          "_sourceTheme": "supplym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer1\" global once=\"footers\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" name=\"socialCount\" title=\"Social Count\" min=\"1\" max=\"4\" step=\"1\" value=\"4\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Icons Bg\" value=\"#f7760c\" name=\"icon\" condition=\"showSocial\" selected>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopyright\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-6 col-md-6\">\n                <h3 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>\n                    VISCOM SYSTEMS</b><br></h3>\n                <div class=\"soc-wrapper\" mbr-if=\"showSocial\">\n                    <p class=\"mbr-soc mbr-fonts-style\" data-app-selector=\".mbr-soc, .mbr-iconfont\" mbr-theme-style=\"display-7\">\n                        <span class=\"mobi-mbri mobi-mbri-letter mbr-iconfont\"></span><a href=\"mailto:cluafer@viscomerie.com\" class=\"text-info\">&nbsp;jtebalt@viscomerie.com</a></p>\n                    <p class=\"mbr-soc mbr-fonts-style\" data-app-selector=\".mbr-soc, .mbr-iconfont\" mbr-theme-style=\"display-7\" mbr-if=\"socialCount > 1\">\n                        <span class=\"mobi-mbri mobi-mbri-mobile mbr-iconfont\"></span><a href=\"tel:+1-814-899-2460\" class=\"text-info\" style=\"font-size: 1.4rem;\">814.899.2460</a></p>\n                    <p class=\"mbr-soc mbr-fonts-style\" data-app-selector=\".mbr-soc, .mbr-iconfont\" mbr-theme-style=\"display-7\" mbr-if=\"socialCount > 2\">\n                        <span class=\"mobi-mbri mobi-mbri-map-pin mbr-iconfont\"></span><a href=\"https://goo.gl/maps/whBTXzejXt672H5y5\" class=\"text-info\" style=\"font-size: 1.4rem;\">4616 Buffalo Rd</a><span style=\"font-size: 1.4rem;\">.&nbsp;</span><a href=\"https://goo.gl/maps/whBTXzejXt672H5y5\" class=\"text-info\" style=\"font-size: 1.4rem;\">Erie, PA, 16510</a></p>\n                    <p class=\"mbr-soc mbr-fonts-style\" data-app-selector=\".mbr-soc, .mbr-iconfont\" mbr-theme-style=\"display-7\" mbr-if=\"socialCount > 3\">\n                        <span class=\"mobi-mbri mobi-mbri-add-submenu mbr-iconfont\"></span><a href=\"Industry_Experience.html\" class=\"text-warning\">INDUSTRY EXPERIENCE</a></p>                                                                    \n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 col-md-6\">\n                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list\" data-multiline mbr-article mbr-if=\"showList\">\n                    <li class=\"mbr-text item-wrap\"><span style=\"font-size: calc(1.28rem + 0.52 * ((100vw - 20rem) / 28));\">SIN</span><span style=\"font-size: calc(1.28rem + 0.52 * ((100vw - 20rem) / 28));\">CE&nbsp;</span><i style=\"color: rgb(252, 143, 18); font-size: calc(1.28rem + 0.52 * ((100vw - 20rem) / 28));\">1995!</i></li>\n                </ul>\n            </div>\n            <div class=\"col-12\" mbr-if=\"showCopyright\">\n                <p class=\"mbr-fonts-style copyright\" mbr-theme-style=\"display-4\" data-app-selector=\".copyright\">© Copyright 2025 Viscom Systems - All Rights Reserved<br>POWERED by <b><a href=\"https://erieapps.com\" class=\"text-danger\">ERIE APPLICATIONS</a></b></p>\n            </div>\n        </div>\n    </div>\n</section>",
