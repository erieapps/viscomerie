              ".google-map": {
                "padding": "0 120px 0 60px",
                "& when (@reverseContent)": {
                  "padding": "0 60px 0 120px",
                  "@media (max-width: 1200px)": {
                    "padding": "0 30px"
                  },
                  "@media (max-width: 992px)": {
                    "padding": "0"
