    "screenshot": "screenshot.png",
    "global_footer_custom": "<script>\nconst rightSlideInElements = document.querySelectorAll('.right-image-slide-in');\n\nconst rightSlideInOptions = {\n  rootMargin: '-50px 0px',\n  threshold: 0.1\n};\n\nconst rightSlideInObserver = new IntersectionObserver(function(rightEntries, rightObserver) {\n  rightEntries.forEach(rightEntry => {\n    if (rightEntry.isIntersecting) {\n      rightEntry.target.classList.add('right-image-slide-in-active');\n      rightObserver.unobserve(rightEntry.target);\n    }\n  });\n}, rightSlideInOptions);\n\nrightSlideInElements.forEach(rightElement => {\n  // check if the element is already in view\n  if (rightIsElementInViewport(rightElement)) {\n    rightElement.classList.add('right-image-slide-in-active');\n  } else {\n    rightSlideInObserver.observe(rightElement);\n  }\n});\n\nfunction rightIsElementInViewport(rightElement) {\n  const rightRect = rightElement.getBoundingClientRect();\n  return (\n    rightRect.top >= 0 &&\n    rightRect.left >= 0 &&\n    rightRect.bottom <= (window.innerHeight || document.documentElement.clientHeight) &&\n    rightRect.right <= (window.innerWidth || document.documentElement.clientWidth)\n  );\n}\n\n\nconst leftSlideInElements = document.querySelectorAll('.left-image-slide-in');\n\nconst leftSlideInOptions = {\n  rootMargin: '-50px 0px',\n  threshold: 0.25\n};\n\nconst leftSlideInObserver = new IntersectionObserver(function(leftEntries, leftObserver) {\n  leftEntries.forEach(leftEntry => {\n    if (leftEntry.isIntersecting) {\n      leftEntry.target.classList.add('left-image-slide-in-active');\n      leftObserver.unobserve(leftEntry.target);\n    }\n  });\n}, leftSlideInOptions);\n\nleftSlideInElements.forEach(leftElement => {\n  // check if the element is already in view\n  if (leftIsElementInViewport(leftElement)) {\n    leftElement.classList.add('left-image-slide-in-active');\n  } else {\n    leftSlideInObserver.observe(leftElement);\n  }\n});\n\nfunction leftIsElementInViewport(leftElement) {\n  const leftRect = leftElement.getBoundingClientRect();\n  return (\n    leftRect.top >= 0 &&\n    leftRect.left >= 0 &&\n    leftRect.bottom <= (window.innerHeight || document.documentElement.clientHeight) &&\n    leftRect.right <= (window.innerWidth || document.documentElement.clientWidth)\n  );\n}\n\nconst slideInElements = document.querySelectorAll('.image-slide-in');\n\nconst slideInOptions = {\n  rootMargin: '0px 0px -50% 0px',\n  threshold: 0.25\n};\n\nconst slideInObserver = new IntersectionObserver(function(entries, observer) {\n  entries.forEach(entry => {\n    if (entry.isIntersecting) {\n      entry.target.classList.add('image-slide-in-active');\n      observer.unobserve(entry.target);\n    }\n  });\n}, slideInOptions);\n\nslideInElements.forEach(element => {\n  slideInObserver.observe(element);\n});\n\n\n\nvar counterElement = document.getElementsByClassName('header-counter')[0];\nvar counterReached = false;\n\nwindow.addEventListener('scroll', function() {\n  if (!counterReached && isElementInViewport(counterElement)) {\n    startCounter();\n    counterReached = true;\n  }\n});\n\nfunction startCounter() {\n  var count = 0;\n  var timer = setInterval(function() {\n    count++;\n    counterElement.innerHTML = \"Over \" + count + \" years of experience!\";\n    if (count >= 60) {\n      clearInterval(timer);\n    }\n  }, 75);\n}\n\nfunction isElementInViewport(el) {\n  var rect = el.getBoundingClientRect();\n  return (\n    rect.top >= 0 &&\n    rect.left >= 0 &&\n    rect.bottom <= (window.innerHeight || document.documentElement.clientHeight) &&\n    rect.right <= (window.innerWidth || document.documentElement.clientWidth)\n  );\n}\n\n\n</script>",
    "global_header_custom": "<style>\n\n.right-image-slide-in {\n  opacity: 0;\n  transform: translateX(50%);\n  transition: opacity 1s ease, transform 1s ease;\n}\n\n.right-image-slide-in-active {\n  opacity: 1;\n  transform: translateX(0);\n}\n\n.left-image-slide-in {\n  opacity: 0;\n  transform: translateX(-50%);\n  transition: opacity 1s ease, transform 1s ease;\n}\n\n.left-image-slide-in-active {\n  opacity: 1;\n  transform: translateX(0);\n}\n\n.image-slide-in {\n  opacity: 0;\n  transform: translateX(-50%);\n  transition: opacity 0.6s ease-out, transform 0.6s ease-out;\n}\n\n.image-slide-in-active {\n  opacity: 1;\n  transform: translateX(0);\n}\n\n</style>",
    "chatbutton": {},
    "google-analytics": "<!-- Google tag (gtag.js) -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-GNE7D0F3Q5\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n\n  gtag('config', 'G-GNE7D0F3Q5');\n</script>",
