            },
            ".mbr-card-title": {
              "color": "#570000"
            },
            ".mbr-desc": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-card-title, .mbr-section-btn": {
              "text-align": "center",
              "color": "#f7760c"
            }
